--binarygrouping none
--commas inline
--decimalgrouping none
--extensionacl on-declarations
--header strip
--hexgrouping none
--ifdef no-indent
--importgrouping testable-top
--indent 4
--maxwidth 150
--modifierorder override,acl,setterACL,dynamic,mutators,lazy,final,required,convenience,typeMethods,owned
--nospaceoperators ...,..<
--octalgrouping none
--patternlet hoist
--self init-only
--semicolons never
--stripunusedargs closure-only
--wraparguments before-first
--wrapcollections before-first
--wrapconditions before-first
--wrapparameters before-first

--enable isEmpty

# Converting the test suite's `try!` calls to throwing test methods is a
# behavioral change to the tests, so it is deferred to its own pass.
--disable noForceTryInTests

# This rule moves the brace of a multiline condition onto its own line, which
# SwiftLint's opening_brace rule then rejects. Only CI runs both, so the
# disagreement surfaces as a failed lint job after the formatter has passed
# locally. SwiftLint wins, since it is the stricter of the two here.
--disable wrapMultilineStatementBraces

--exclude DerivedData
